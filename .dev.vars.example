# Secrets. Copy to .dev.vars and never commit it.
# Deploy to Cloudflare prompts only for these. Generate both with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Keep this stable across environments that share a database. Rotating it
# means users must reconnect GitHub and GitLab.
PROVIDER_TOKEN_KEY=replace-with-another-openssl-rand-base64-32
# Local only. Do not set ARTIFACTS_FAKE=true on a deployed Worker.
# ARTIFACTS_FAKE=true
# Optional self-hosted GitLab base URL. Defaults to https://gitlab.com.
# GITLAB_BASE_URL=https://gitlab.com
# Local-only provider demo mode. Never enable it in production.
# GIT_PROVIDERS_FAKE=true
