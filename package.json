{
  "name": "cloudflare-git",
  "version": "0.1.0",
  "private": true,
  "description": "Git collaboration on Cloudflare Workers, D1, and Artifacts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:clean": "rm -rf node_modules/.vite && tsx scripts/dev.ts",
    "dev:e2e": "tsx scripts/e2e-server.ts",
    "build": "vite build",
    "preview": "npm run build && tsx scripts/dev.ts preview",
    "deploy": "tsx scripts/check-deploy.ts && npm run db:migrate && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.19",
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "isomorphic-git": "^1.44.12",
    "lucide-react": "^1.71.0",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "miniflare": "5.20261103.0-beta",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261109.1": true
  },
  "cloudflare": {
    "bindings": {
      "APP_URL": {
        "description": "Optional. Leave the localhost default. The Worker uses the hostname of each request, which is the workers.dev or custom domain Cloudflare serves. Set this only to force one origin."
      },
      "APP_NAME": {
        "description": "Name shown in the header and the browser title."
      },
      "ARTIFACTS_NAMESPACE": {
        "description": "Artifacts namespace for this Worker. Use a different namespace for each environment."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Session signing secret. Generate one with `openssl rand -base64 32`."
      },
      "BETTER_AUTH_URL": {
        "description": "Plain text, not a secret. Optional fallback origin. The Worker uses the hostname of each request."
      },
      "PROVIDER_TOKEN_KEY": {
        "description": "Encrypts saved GitHub and GitLab tokens. Generate a second value with `openssl rand -base64 32`. Keep it stable, or users must reconnect providers."
      },
      "ADMIN_EMAILS": {
        "description": "Comma-separated emails that become admins when those people sign up. Leave empty if you have none. This is plain text."
      }
    }
  }
}
